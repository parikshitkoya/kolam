{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/types/preview",
    "tsBuildInfoFile": "../dist/types/preview/tsconfig.tsbuildinfo",
    "types": [
      "node"
    ],
    "rootDir": ".."
  },
  "include": [
    "../tools/preview/**/*",
    "../src/client/global.ts",
    "../src/client/game/**/*",
    "../src/shared/**/*",
    "../src/server/kolam/**/*"
  ],
  "exclude": [
    "../**/*.test.ts",
    "../src/client/game/useGame.ts"
  ]
}
